# Copy to .env.local for local development. Never commit real values.

# Neon PostgreSQL connection string (use a separate branch/database for preview and dev)
DATABASE_URL="postgresql://user:password@ep-example.neon.tech/portfolio?sslmode=require"

# Better Auth: 32+ character random secret (e.g. `openssl rand -base64 32`)
BETTER_AUTH_SECRET=""
# Base URL of the running app, used by Better Auth for callbacks and cookies
BETTER_AUTH_URL="http://localhost:3000"

# Public URL used for canonical links, sitemap and social metadata
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Used only by `npm run admin:create` to provision the single administrator
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Administrator"
