# Copy to .env.local for local development. Never commit real values.

# Neon PostgreSQL connection string (use a separate branch/database for preview and dev)
# Recommended for most uses
DATABASE_URL=postgresql://example_user:example_password@ep-example-pooler.us-east-1.aws.neon.tech/example_db?sslmode=require

# For uses requiring a connection without pgbouncer
DATABASE_URL_UNPOOLED=postgresql://example_user:example_password@ep-example.us-east-1.aws.neon.tech/example_db?sslmode=require

# Parameters for constructing your own connection string
PGHOST=ep-example-pooler.us-east-1.aws.neon.tech
PGHOST_UNPOOLED=ep-example.us-east-1.aws.neon.tech
PGUSER=example_user
PGDATABASE=example_db
PGPASSWORD=example_password

# Parameters for Vercel Postgres Templates
POSTGRES_URL=postgresql://example_user:example_password@ep-example-pooler.us-east-1.aws.neon.tech/example_db?sslmode=require
POSTGRES_URL_NON_POOLING=postgresql://example_user:example_password@ep-example.us-east-1.aws.neon.tech/example_db?sslmode=require
POSTGRES_USER=example_user
POSTGRES_HOST=ep-example-pooler.us-east-1.aws.neon.tech
POSTGRES_PASSWORD=example_password
POSTGRES_DATABASE=example_db
POSTGRES_URL_NO_SSL=postgresql://example_user:example_password@ep-example-pooler.us-east-1.aws.neon.tech/example_db
POSTGRES_PRISMA_URL=postgresql://example_user:example_password@ep-example-pooler.us-east-1.aws.neon.tech/example_db?connect_timeout=15&sslmode=require


# Public URL of the app. Used for canonical links, sitemap, and to check that admin requests come from this site.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Used only by `npm run admin:create` to create the single administrator
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-to-a-long-password"
ADMIN_NAME="Jane Doe"

# Contact form notifications (Resend). Leave empty to save messages without emailing them.
RESEND_API_KEY="re_example_key"
CONTACT_TO_EMAIL="admin@example.com"
CONTACT_FROM_EMAIL="notifications@example.com"

# Media uploads (Vercel Blob). Leave empty to disable uploads.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_example_token"
